{
  "Global": {
    "developer": "hashicorp",
    "provider": "random",
    "version": "v3.7.2",
    "githubDocsUrl": "https://github.com/hashicorp/terraform-provider-random/tree/{version}/docs/resources",
    "rawMarkdownUrlPattern": "https://raw.githubusercontent.com/hashicorp/terraform-provider-random/refs/heads/{version}/docs/resources/{resource}.md",
    "color": "gray",
    "icon": "hashicorp.png",
    "markers": {
      "argument_start": "",
      "argument_end": ""
    },
    "patterns": {
      "arg_line_inline": null,
      "block_header": "^###\\s+Nested Schema for [`']?([A-Za-z0-9_.-]+)[`']?\\s*$",
      "hr": null,
      "block_ref_phrase": null,
      "backticked_names": null,
      "inference": {
        "is_block": "^block\\b|^block list\\b|^list of object",
        "quantity_multiple": "one or more|zero or more|at least one",
        "quantity_single": "a single|exactly one",
        "type_string": "^string\\b",
        "type_number": "^number\\b",
        "type_boolean": "^boolean\\b",
        "type_map": "^map\\b",
        "type_set": "^set\\b",
        "type_object": "^object\\b",
        "type_list_object": "^list of object",
        "modifier_sensitive": "sensitive"
      }
    },
    "hierarchy": {
      "blocks_use_anchors": true,
      "blocks_use_references": false,
      "required_optional_by_section": true,
      "types_explicit": true
    }
  },
  "Module": {},
  "ResourceGraph": {
    "defaultResource": "password",
    "enableFullDependencyScan": false
  }
}