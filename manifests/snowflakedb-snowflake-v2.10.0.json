{
  "Global": {
    "developer": "snowflakedb",
    "provider": "snowflake",
    "version": "v2.10.0",
    "githubDocsUrl": "https://github.com/Snowflake-Labs/terraform-provider-snowflake/tree/{version}/docs/resources",
    "rawMarkdownUrlPattern": "https://raw.githubusercontent.com/Snowflake-Labs/terraform-provider-snowflake/{version}/docs/resources/{resource}.md",
    "color": "#76bff0",
    "icon": "snowflake.png",
    "markers": {
      "argument_start": null,
      "argument_end": null
    },
    "patterns": {
      "section_required": "^###\\s+Required\\s*$",
      "section_optional": "^###\\s+Optional\\s*$",
      "section_readonly": "^###\\s+Read-Only\\s*$",
      "block_anchor": "<a id=\\\"nestedblock--([^\\\"]+)\\\"></a>",
      "arg_line_inline": "^-\\s+`?([A-Za-z0-9_]+)`?\\s*\\(([^)]+)\\)\\s*(.*)$",
      "block_header": "^###\\s+Nested Schema for [`']?([A-Za-z0-9_.-]+)[`']?\\s*$",
      "hr": null,
      "block_ref_phrase": null,
      "backticked_names": null,
      "inference": {
        "is_block": "^block\\b|^block list\\b|^list of object",
        "quantity_multiple": "one or more|zero or more|at least one",
        "quantity_single": "a single|exactly one",
        "type_string": "^string\\b",
        "type_number": "^number\\b",
        "type_boolean": "^boolean\\b",
        "type_map": "^map\\b",
        "type_set": "^set\\b",
        "type_object": "^object\\b",
        "type_list_object": "^list of object",
        "modifier_sensitive": "sensitive"
      }
    },
    "hierarchy": {
      "blocks_use_anchors": true,
      "blocks_use_references": false,
      "required_optional_by_section": true,
      "types_explicit": true
    }
  },
  "Module": {},
  "ResourceGraph": {
    "defaultResource": "database",
    "enableFullDependencyScan": false
  }
}