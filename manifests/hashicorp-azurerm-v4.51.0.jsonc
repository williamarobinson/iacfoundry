{
    "Global": {
        "developer": "hashicorp",
        "provider": "azurerm",
        "version": "v4.51.0",
        "githubDocsUrl": "https://github.com/hashicorp/terraform-provider-azurerm/tree/{version}/website/docs/r",
        "rawMarkdownUrlPattern": "https://raw.githubusercontent.com/hashicorp/terraform-provider-azurerm/main/website/docs/r/{resource}.html.markdown"
    },
    "Module": {
        "markers": {
            // Matches "## Arguments Reference" or "## Argument Reference"
            // ^## - Start of line with two hashes
            // \\s+ - One or more whitespace
            // Argument - Literal "Argument"
            // [s]? - Optional "s" for plural
            // \\s+ - One or more whitespace
            // Reference - Literal "Reference"
            "argument_start": "## Argument[s]? Reference",
            // Matches "## Attributes Reference" or "## Attribute Reference"
            // ^## - Start of line with two hashes
            // \\s+ - One or more whitespace
            // Attribute - Literal "Attribute"
            // [s]? - Optional "s" for plural
            // \\s+ - One or more whitespace
            // Reference - Literal "Reference"
            "argument_end": "## Attribute[s]? Reference"
        },
        "patterns": {
            // Matches lines like "* `name` - (Required) The name of the resource"
            // ^\\* - Start of line, literal asterisk
            // \\s* - Zero or more whitespace
            // `([^`]+)` - Backtick-enclosed group (1=parameter name)
            // \\s*-\\s* - Dash surrounded by optional whitespace
            // \\((Required|Optional)\\) - Parenthesized group (2=Required or Optional)
            // \\s* - Whitespace
            // ([^\\n]*)$ - Group (3=description until end of line)
            "arg_line_inline": "^\\*\\s*`([^`]+)`\\s*-\\s*\\((Required|Optional)\\)\\s*([^\\n]*)$",
            // Matches "A backend_pool block supports the following:" or "The cache_key blocks support the following:"
            // ^ - Start of line
            // (?:(?:A|An|The)\\s+)? - Optional non-capturing group for articles "A", "An", "The" + whitespace
            // ((?:`[^`]+`(?:\\s*,\\s*`[^`]+`)*)(?:\\s+(?:and|or)\\s+`[^`]+`)?) - Group (1=block names):
            //   - `[^`]+` - Backtick-enclosed block name
            //   - (?:\\s*,\\s*`[^`]+`)* - Zero or more comma-separated backtick blocks
            //   - (?:\\s+(?:and|or)\\s+`[^`]+`)? - Optional "and"/"or" + another backtick block
            // \\s+blocks?\\s+ - "block" or "blocks" + whitespace
            // support[s]? - "support" or "supports"
            // \\s+the\\s+following: - Literal "the following:"
            "block_header": "^(?:(?:A|An|The)\\s+)?((?:`[^`]+`(?:\\s*,\\s*`[^`]+`)*)(?:\\s+(?:and|or)\\s+`[^`]+`)?)\\s+blocks?\\s+support[s]?\\s+the\\s+following:",
            // Matches horizontal rules with 3+ dashes: "---" or "-----"
            // ^\\s* - Start of line + optional whitespace
            // -{3,} - Three or more dashes
            // \\s*$ - Optional trailing whitespace + end of line
            "hr": "^\\s*-{3,}\\s*$",
            // Matches phrases like "as defined below" or "as documented above"
            // as\\s+ - Literal "as" + whitespace
            // (defined|documented) - Group matching either word
            // \\s+ - Whitespace
            // (below|above) - Literal direction
            "block_ref_phrase": "(?:as\\s+(defined|documented)\\s+(?:below|above))",
            // Matches text enclosed in backticks: `example`
            // ` - Literal backtick
            // ([^`]+) - Group (1=text inside backticks, any non-backtick chars)
            // ` - Literal closing backtick
            "backticked_names": "`([^`]+)`",
            "inference": {
                // Matches block type indicators
                // ^block\\b - Literal "block" at line start followed by word boundary (e.g., "block", "block list")
                // | - OR operator
                // ^block list\\b - Literal "block list" at line start followed by word boundary
                // | - OR operator
                // ^list of object - Literal "list of object" at line start
                // Examples: "block", "block list", "list of object"
                "is_block": "^block\\b|^block list\\b|^list of object",
                // Matches multiple quantity descriptors
                // one or more - Literal phrase indicating 1+ items
                // | - OR operator
                // zero or more - Literal phrase indicating 0+ items
                // | - OR operator
                // at least one - Literal phrase indicating 1+ items
                // Examples: "one or more", "zero or more", "at least one"
                "quantity_multiple": "one or more|zero or more|at least one",
                // Matches singular quantity descriptors
                // a single - Literal phrase indicating exactly 1 item
                // | - OR operator
                // exactly one - Literal phrase indicating exactly 1 item
                // Examples: "a single", "exactly one"
                "quantity_single": "a single|exactly one",
                // Matches string type indicator at line start
                // ^ - Start of line
                // string - Literal "string"
                // \\b - Word boundary (ensures "string" is standalone)
                // Examples match: "string", but not "stringified"
                "type_string": "^string\\b",
                // Matches number type indicator at line start
                // ^ - Start of line
                // number - Literal "number"
                // \\b - Word boundary (ensures "number" is standalone)
                // Examples match: "number", but not "numbered"
                "type_number": "^number\\b",
                // Matches boolean type indicator at line start
                // ^ - Start of line
                // boolean - Literal "boolean"
                // \\b - Word boundary (ensures "boolean" is standalone)
                // Examples match: "boolean", but not "booleanish"
                "type_boolean": "^boolean\\b",
                // Matches map type indicator at line start
                // ^ - Start of line
                // map - Literal "map"
                // \\b - Word boundary (ensures "map" is standalone)
                // Examples match: "map", but not "mapping"
                "type_map": "^map\\b",
                // Matches set type indicator at line start
                // ^ - Start of line
                // set - Literal "set"
                // \\b - Word boundary (ensures "set" is standalone)
                // Examples match: "set", but not "setting"
                "type_set": "^set\\b",
                // Matches object type indicator at line start
                // ^ - Start of line
                // object - Literal "object"
                // \\b - Word boundary (ensures "object" is standalone)
                // Examples match: "object", but not "objective"
                "type_object": "^object\\b",
                // Matches list of object phrase at line start
                // ^ - Start of line
                // list of object - Literal phrase
                // Examples match: "list of object" at beginning of line
                "type_list_object": "^list of object",
                // Matches sensitive modifier anywhere in text
                // sensitive - Literal "sensitive" string match
                // Examples: "sensitive", "very sensitive", "marked sensitive"
                "modifier_sensitive": "sensitive"
            }
        },
        "hierarchy": {
            "blocks_use_anchors": false,
            "blocks_use_references": true,
            "required_optional_by_section": false,
            "types_explicit": false
        }
    },
    "ResourceGraph": {
        "enableFullDependencyScan": false,
        "defaultResource": "subnet"
    }
}